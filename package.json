{
  "name": "opencode-langfuse-observability-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./plugins/receiver/index.js",
  "files": [
    "plugins/receiver/index.js",
    "dist/app.js",
    "dist/config.js",
    "dist/dashboard-data.js",
    "dist/dashboard.js",
    "dist/model-pricing.js",
    "dist/server.js",
